# Free registration: https://open.fda.gov/apis/authentication/
# Optional but strongly recommended -- raises the rate limit from
# 40 requests/min & 1,000/day (no key) to 240/min & 120,000/day.
OPENFDA_API_KEY=

# Override where config/data live if you don't want repo-relative defaults.
# MARKET_INTEL_CONFIG_DIR=/path/to/config
# MARKET_INTEL_DATA_DIR=/path/to/data
# MARKET_INTEL_DB_PATH=/path/to/market_intel.sqlite
